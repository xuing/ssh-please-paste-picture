# Normalize line endings: the repository stores LF, checkouts use the rules below.
* text=auto

# Windows-side files are checked out with CRLF.
# - .cmd: cmd.exe misparses batch files with LF-only line endings (labels,
#   goto, long lines), so CRLF is required.
# - .ps1 / .psd1: Windows PowerShell 5.1 and PowerShell 7 accept LF too; we use
#   CRLF so a Windows checkout matches what Windows editors and Authenticode
#   signing expect, and so all Windows-side files follow one rule.
# Note: eol only applies to checkouts. Files fetched from raw.githubusercontent.com
# are the stored (LF) blobs, so anything that must be CRLF on the user's
# computer (the .cmd shim) is written by the installer itself.
*.ps1  text eol=crlf
*.psd1 text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Unix-side files keep LF.
*.sh   text eol=lf

*.png  binary
*.jpg  binary
*.gif  binary
